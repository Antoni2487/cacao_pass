# Copia este archivo como .env.local y completa los valores.
# Nunca subas .env.local a GitHub.

# --- Supabase (Project Settings > API) ---
# Públicas: pueden viajar al navegador (están protegidas por RLS)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secreta: salta RLS. Solo se usa en el servidor.
SUPABASE_SERVICE_ROLE_KEY=

# --- Blockchain Polygon ---
# Red donde se sella:
#   amoy    -> red de prueba (POL gratis de faucet, sin valor)
#   polygon -> red principal (POL real; cada sello cuesta milésimas de POL)
# OJO: no cambies de red con etapas ya selladas, sus sellos quedan en la red anterior.
NEXT_PUBLIC_RED_BLOCKCHAIN=amoy
# Opcional. Si se deja vacío se usa el RPC público de publicnode para la red elegida.
# Para más estabilidad, una URL de Alchemy de ESA red, p. ej.:
#   https://polygon-mainnet.g.alchemy.com/v2/<api-key>
RPC_URL=
# Clave privada de la wallet que sella. Créala con: npm run wallet:nueva
# Con la red principal guarda dinero real: nunca la compartas ni la subas a GitHub.
WALLET_PRIVATE_KEY=

# --- Cron de Vercel (mantiene Supabase activo) ---
# Texto largo y aleatorio. Genéralo con: node -e "console.log(crypto.randomUUID())"
# Ponlo también en Vercel (Settings > Environment Variables): Vercel lo envía al llamar al cron.
CRON_SECRET=

# --- Sitio ---
# URL pública que irá dentro de los QR (en local: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
