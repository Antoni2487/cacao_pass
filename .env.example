# Copia este archivo como .env.local y completa los valores.
# Nunca subas .env.local a GitHub.

# --- Supabase (Project Settings > API) ---
# Públicas: pueden viajar al navegador (están protegidas por RLS)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secreta: salta RLS. Solo se usa en el servidor.
SUPABASE_SERVICE_ROLE_KEY=

# --- Blockchain Polygon Amoy ---
# Opcional. Si se deja vacío se usa el RPC público https://polygon-amoy-bor-rpc.publicnode.com
# Para más estabilidad: Alchemy -> https://polygon-amoy.g.alchemy.com/v2/<api-key>
AMOY_RPC_URL=
# Clave privada de una wallet SOLO de prueba. Créala con: npm run wallet:nueva
WALLET_PRIVATE_KEY=

# --- Sitio ---
# URL pública que irá dentro de los QR (en local: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
